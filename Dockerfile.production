# Build stage
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY prisma ./prisma/

# Install ALL dependencies (dev dependencies needed for build)
RUN npm ci && npm cache clean --force

# Copy source code
COPY . .

# Generate Prisma client
RUN npm run prisma:generate

# Build the application (requires dev dependencies)
RUN npm run build

# Remove dev dependencies after build to save space
RUN npm prune --production

# Production stage - Use Node.js with manual Chrome installation
FROM node:22-alpine AS production

WORKDIR /app

# Install Chrome and dependencies
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    freetype-dev \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    ttf-dejavu \
    ttf-droid \
    ttf-liberation \
    fontconfig \
    font-noto \
    font-noto-arabic \
    font-noto-emoji

# Copy built application and pruned node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/prisma ./prisma

# Copy custom fonts and templates
#COPY --from=builder /app/src/modules/contracts/tenancy-contracts/templates ./src/modules/contracts/tenancy-contracts/templates

# Install custom fonts system-wide and refresh font cache
#RUN mkdir -p /usr/share/fonts/custom && \
#    cp -r ./src/modules/contracts/tenancy-contracts/templates/fonts/* /usr/share/fonts/custom/ && \
#    fc-cache -fv

# Create uploads and logs directories
RUN mkdir -p uploads logs

# Create non-root user and set permissions
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nestjs -u 1001 && \
    chown -R nestjs:nodejs /app

# Set Puppeteer to use system Chrome
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

USER nestjs

# Expose port
EXPOSE 3000

# Start the application (DatabaseInitializerService will handle migrations , seeding will be throw API)
CMD ["node", "dist/src/main.js"] 