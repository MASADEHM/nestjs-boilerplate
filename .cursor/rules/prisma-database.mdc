# Prisma Database Patterns

## Basic Query

```typescript
@Injectable()
export class ItemService {
  constructor(private readonly prisma: PrismaService) {}

  async findById(id: number): Promise<Item | null> {
    return this.prisma.items.findUnique({ where: { id } });
  }
}
```

## Pagination Pattern

```typescript
async findAll(page: number, limit: number): Promise<PaginatedResponse<Item>> {
  const [data, total] = await Promise.all([
    this.prisma.items.findMany({
      skip: (page - 1) * limit,
      take: limit,
    }),
    this.prisma.items.count(),
  ]);

  return { data, total, page, limit };
}
```

## Transactions

```typescript
// Use $transaction for related operations
const result = await this.prisma.$transaction(async (tx) => {
  const user = await tx.users.create({ data: userData });
  const profile = await tx.profiles.create({
    data: { ...profileData, userId: user.id }
  });
  return { user, profile };
});
```

## Audit Fields

```typescript
// Always use createAuditFields helper
const auditFields = createAuditFields(auditInfo);
await this.prisma.users.create({
  data: { ...dto, ...auditFields }
});
```
