<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Password Reset - {{companyName}}</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu,
          Cantarell, sans-serif;
        line-height: 1.6;
        color: #333333;
        background-color: #f8fafc;
      }

      .email-container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        overflow: hidden;
      }

      .header {
        background: linear-gradient(135deg, #e53e3e 0%, #c53030 100%);
        padding: 40px 30px;
        text-align: center;
        color: white;
      }

      .header h1 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 8px;
      }

      .header p {
        font-size: 16px;
        opacity: 0.9;
      }

      .content {
        padding: 40px 30px;
      }

      .greeting {
        font-size: 18px;
        font-weight: 600;
        color: #1a202c;
        margin-bottom: 20px;
      }

      .message {
        font-size: 16px;
        color: #4a5568;
        margin-bottom: 30px;
        line-height: 1.7;
      }

      .security-alert {
        background-color: #fff5f5;
        border-left: 4px solid #e53e3e;
        padding: 20px;
        margin: 30px 0;
        border-radius: 0 8px 8px 0;
      }

      .security-alert h3 {
        color: #c53030;
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 12px;
      }

      .security-alert p {
        font-size: 14px;
        color: #4a5568;
        margin-bottom: 8px;
      }

      .cta-button {
        display: inline-block;
        background: linear-gradient(135deg, #e53e3e 0%, #c53030 100%);
        color: white;
        text-decoration: none;
        padding: 16px 32px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 16px;
        text-align: center;
        margin: 20px 0;
        transition: transform 0.2s ease;
      }

      .cta-button:hover {
        transform: translateY(-2px);
      }

      .reset-details {
        background-color: #f7fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 20px;
        margin: 30px 0;
      }

      .reset-details h3 {
        color: #2d3748;
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 12px;
      }

      .detail-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 14px;
      }

      .detail-label {
        font-weight: 600;
        color: #4a5568;
      }

      .detail-value {
        color: #2d3748;
      }

      .footer {
        background-color: #f7fafc;
        padding: 30px;
        text-align: center;
        border-top: 1px solid #e2e8f0;
      }

      .footer p {
        font-size: 14px;
        color: #718096;
        margin-bottom: 8px;
      }

      .footer a {
        color: #e53e3e;
        text-decoration: none;
      }

      .security-tips {
        background-color: #f0fff4;
        border: 1px solid #9ae6b4;
        border-radius: 8px;
        padding: 16px;
        margin: 20px 0;
        font-size: 14px;
        color: #22543d;
      }

      .security-tips h4 {
        color: #2f855a;
        margin-bottom: 8px;
      }

      .security-tips ul {
        margin-left: 16px;
      }

      .security-tips li {
        margin-bottom: 4px;
      }

      .not-you {
        background-color: #fffaf0;
        border: 1px solid #fbd38d;
        border-radius: 8px;
        padding: 16px;
        margin: 20px 0;
        font-size: 14px;
        color: #744210;
        text-align: center;
      }

      @media (max-width: 600px) {
        .email-container {
          margin: 0;
          border-radius: 0;
        }

        .header,
        .content,
        .footer {
          padding: 20px;
        }

        .header h1 {
          font-size: 24px;
        }
      }
    </style>
  </head>
  <body>
    <div class='email-container'>
      <div class='header'>
        <h1>🔐 Password Reset</h1>
        <p>{{companyName}} Security</p>
      </div>

      <div class='content'>
        <div class='greeting'>
          Hello
          {{userName}},
        </div>

        <div class='message'>
          We received a request to reset the password for your
          <strong>{{companyName}}</strong>
          admin account. If you made this request, click the button below to set
          a new password.
        </div>

        <div class='security-alert'>
          <h3>🚨 Security Alert</h3>
          <p><strong>Request Details:</strong></p>
          <p>• Time: {{requestTime}}</p>
          <p>• IP Address: {{ipAddress}}</p>
          <p>• User Agent: {{userAgent}}</p>
        </div>

        <div style='text-align: center;'>
          <a href='{{resetLink}}' class='cta-button'>
            Reset My Password
          </a>
        </div>

        <div class='reset-details'>
          <h3>Reset Information</h3>
          <div class='detail-item'>
            <span class='detail-label'>Account Email:</span>
            <span class='detail-value'>{{email}}</span>
          </div>
          <div class='detail-item'>
            <span class='detail-label'>Reset Token Expires:</span>
            <span class='detail-value'>{{expirationTime}}</span>
          </div>
          <div class='detail-item'>
            <span class='detail-label'>Request ID:</span>
            <span class='detail-value'>{{requestId}}</span>
          </div>
        </div>

        <div class='security-tips'>
          <h4>🛡️ Security Best Practices</h4>
          <ul>
            <li>Use a strong, unique password with at least 12 characters</li>
            <li>Include uppercase, lowercase, numbers, and special characters</li>
            <li>Don't reuse passwords from other accounts</li>
            <li>Consider using a password manager</li>
            <li>Enable two-factor authentication if available</li>
          </ul>
        </div>

        <div class='not-you'>
          <strong>Didn't request this reset?</strong><br />
          If you didn't request a password reset, please ignore this email or
          <a href='{{supportLink}}' style='color: #c05621;'>contact our security
            team</a>
          immediately. Your password will remain unchanged.
        </div>

        <div class='message'>
          This password reset link will expire in
          <strong>{{expirationHours}} hours</strong>
          for your security. If you need assistance, please contact our support
          team.
        </div>
      </div>

      <div class='footer'>
        <p><strong>{{companyName}} Security Team</strong></p>
        <p>This is an automated security message. Please do not reply to this
          email.</p>
        {{#if supportEmail}}
          <p>Security concerns? Contact us at
            <a href='mailto:{{supportEmail}}'>{{supportEmail}}</a></p>
        {{/if}}
        <p style='margin-top: 16px; font-size: 12px;'>
          ©
          {{currentYear}}
          {{companyName}}. All rights reserved.
        </p>
      </div>
    </div>
  </body>
</html>